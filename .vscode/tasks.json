{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run",
      "type": "shell",
      "command": "uv run python-template",
      "problemMatcher": []
    },
    {
      "label": "Install lefthook",
      "type": "shell",
      "command": "uv run lefthook install",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      // Изменили настройки линтера или форматера? Обязательно запустите.
      "label": "Run pre-commit for all files",
      "type": "shell",
      "command": "uv run lefthook run pre-commit --all-files",
      "problemMatcher": []
    },
    {
      "label": "Update from template",
      "type": "shell",
      "command": "uv run copier update",
      "presentation": { "focus": true },
      "problemMatcher": []
    }
  ]
}
